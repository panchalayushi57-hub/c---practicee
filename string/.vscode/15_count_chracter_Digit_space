#include<stdio.h>
#include<string.h>
int main()
{
    char text[]= "Hello 123";
    int letters = 0, digits = 0, spaces = 0;
    for(int i=0; text[i]!='\0' ; i++ )
    {
    if((text[i]>='A' && text[i]<='Z') || (text[i]>='a' && text[i]<='z'))letters++;
    else if(text[i]>='0' && text[i]<='9')digits++;
    else if(text[i] == ' ')spaces++;


}
printf("Letters =%d, Digits=%d, spaces=%d",letters, digits,spaces);
return 0;
}